#!/usr/bin/python
from __future__ import annotations
from abc import abstractmethod
from argparse import ArgumentParser, Namespace
import shutil
from pathlib import Path
from dataclasses import dataclass, field
import socket
from typing import List, Dict, Optional


def expand(path: str) -> Path:
    return Path(path).expanduser().resolve()


def log(msg: str, comp: Optional[str] = None):
    pref = "" if not comp else f"[{comp}]: "
    print(f"{pref}{msg}")


@dataclass
class Configuration:
    override: bool
    dry: bool
    verbose: bool

    @staticmethod
    def from_args(args: Namespace) -> Configuration:
        return Configuration(args.override, args.dry, args.verbose)


@dataclass
class Component:
    name: str  # name of the component
    dst: str  # where should the file / dir be linked to?

    def handle_override(self, dstpath: Path, cfg: Configuration) -> bool:
        """Handle the override logic for a target symlink.

        Args:
            dstpath (Path): The target.
            cfg (Configuration): The configuration
            override (bool): Is override enabled?

        Returns:
            bool: should we exit early?
        """
        if dstpath.exists():
            if not cfg.override:
                log(
                    f"Config files exist and --override is not set! Skipping...",
                    comp=self.name,
                )
                return True

            if dstpath.is_dir():
                log(f"Removing existing folder at {dstpath}", comp=self.name)
                if not cfg.dry:
                    shutil.rmtree(dstpath)
            else:
                log(f"Removing existing file at {dstpath}", comp=self.name)
                if not cfg.dry:
                    dstpath.unlink()

        return False

    @abstractmethod
    def link(self, cfg: Configuration):
        pass


@dataclass
class FileComponent(Component):
    src: str

    def link(self, cfg: Configuration):
        srcpath = expand(f"{Path.cwd()}/{self.src}")
        # FIXME: if the target exists, we can get recursive links
        # since we follow this link back to `srcpath` and then
        # we try to link `srcpath` to itself
        target = expand(f"~/{self.dst}")

        if target.is_dir():
            target = target / srcpath.name

        if self.handle_override(target, cfg):
            return

        log(f"Linking {target} to {srcpath}!")

        if not cfg.dry:
            target.symlink_to(srcpath)


@dataclass
class FolderComponent(Component):
    mk_subdir: bool = (
        False  # If set, files go into dst/name/*. Otherwise they go into dst.
    )

    def link(self, cfg: Configuration):
        dst = expand(f"~/{self.dst}")

        if self.mk_subdir:
            # if we want a subdirectory, add it to dstpath
            dstprefix = dst / self.name
        else:
            # otherwise, `dst` is the output path
            dstprefix = dst

        # create the output directory if its not there
        if not dstprefix.exists():
            log(f"Creating subdirectory {dst}", comp=self.name)
            dstprefix.mkdir(parents=True)

        srcprefix = expand(f"{Path.cwd()}/{self.name}/")

        # loop through all files in the folder
        for srcfile in srcprefix.iterdir():
            # link each one to dstpath
            srcpath = srcprefix / srcfile.name
            target = dstprefix / srcfile.name

            if self.handle_override(target, cfg):
                return

            log(f"Linking {target} to {srcpath}!", comp=self.name)

            if not cfg.dry:
                target.symlink_to(srcpath)


hypr = FolderComponent("hypr", ".config", mk_subdir=True)
emacs = FolderComponent("emacs", ".emacs.d")
ghostty = FolderComponent("ghostty", ".config", mk_subdir=True)
zsh = FileComponent("zsh", ".zshrc", src="zsh/.zshrc")
starship = FileComponent("starship", ".config/starship.toml", src="starship/starship.toml")

HOST_ALIASES = {
    "VA-LV3TW207K": "work",
    "ip-10-97-122-31": "cirrus"
}


@dataclass
class Registry:
    cfg: Configuration
    registry: Dict[str, List[Component]] = field(default_factory=dict)
    required_components: List[Component] = field(
        default_factory=lambda: [emacs, ghostty, zsh, starship]
    )

    def register(self, hostname: str, comps: List[Component]):
        self.registry[hostname] = comps

    def make_links(self):
        host = socket.gethostname()

        # Get the alias if there is one
        host_alias = HOST_ALIASES.get(host, host)

        comps = self.registry[host_alias]
        comps.extend(self.required_components)

        for c in comps:
            c.link(self.cfg)


def parse_args() -> Namespace:
    parser = ArgumentParser()

    parser.add_argument(
        "--dry", help="Do not generate symlinks, just output logs.", action="store_true"
    )

    parser.add_argument(
        "--override", help="Overwrite any existing symlinks.", action="store_true"
    )

    parser.add_argument(
        "--verbose", help="Enable verbose logging.", action="store_true"
    )

    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()

    registry = Registry(Configuration.from_args(args))
    registry.register("redwood", [hypr])

    registry.register("work", [])
    registry.register("cirrus", [])

    registry.make_links()
